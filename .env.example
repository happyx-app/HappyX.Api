# Copy to .env (git-ignored) and fill in. Never commit real values.
DATABASE_URL=postgres://happyx:change-me@localhost:5432/happyx?sslmode=disable
HTTP_ADDR=:8080
# Comma separated SHA-256 hex digests of the allowed API keys (one per client).
# Generate a key and its hash with:
#   KEY=$(openssl rand -hex 32); echo "key:  $KEY"; echo -n "$KEY" | sha256sum
API_KEY_HASHES=
# Web dashboard login (optional). Leave DISCORD_CLIENT_ID empty to disable it.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
WEB_URL=http://localhost:8084
# openssl rand -hex 32
SESSION_SECRET=
